# Dockerfile for building AppImage with glibc 2.17 compatibility (CentOS 7)
# This allows building on newer systems while maintaining compatibility with CentOS 7+ and Ubuntu 16.04+

FROM centos:7

# Install EPEL repository for additional packages
RUN yum install -y epel-release

# Install Software Collections repository for devtoolset (GCC 5.1+ for C++14)
RUN yum install -y centos-release-scl

# Install build dependencies and devtoolset-7 (GCC 7.3 - supports C++14)
# devtoolset-7 provides GCC 7.3 which fully supports C++14
RUN yum install -y \
    git \
    cmake \
    make \
    wget \
    fuse \
    perl \
    devtoolset-7-gcc \
    devtoolset-7-gcc-c++ \
    && yum clean all

# Install Qt5 development packages from EPEL
# Note: CentOS 7 may have limited Qt5 packages, we install what's available
RUN yum install -y \
    qt5-qtbase-devel \
    qt5-qtdeclarative-devel \
    qt5-qttools-devel \
    && yum clean all || true

# Enable devtoolset-7 in the environment
# This sets up GCC 7.3 and G++ 7.3 in the PATH
ENV PATH="/opt/rh/devtoolset-7/root/usr/bin:$PATH"
ENV CC="/opt/rh/devtoolset-7/root/usr/bin/gcc"
ENV CXX="/opt/rh/devtoolset-7/root/usr/bin/g++"

# Install newer cmake if needed (CentOS 7 has cmake 2.8, may need newer)
# Uncomment and adjust version as needed:
# RUN wget https://github.com/Kitware/CMake/releases/download/v3.20.0/cmake-3.20.0-Linux-x86_64.sh \
#     && chmod +x cmake-3.20.0-Linux-x86_64.sh \
#     && mkdir -p /opt/cmake \
#     && ./cmake-3.20.0-Linux-x86_64.sh --prefix=/opt/cmake --skip-license \
#     && rm cmake-3.20.0-Linux-x86_64.sh

# Install OpenSSL 1.1.1 from source for compatibility with distros using OpenSSL 1.0
# Qt 5.x uses OpenSSL 1.1.x, and bundling 1.1.1 ensures compatibility with older systems
RUN yum install -y \
    gcc \
    make \
    perl \
    && yum clean all \
    && wget -q https://www.openssl.org/source/openssl-1.1.1w.tar.gz \
    && tar -xzf openssl-1.1.1w.tar.gz \
    && cd openssl-1.1.1w \
    && ./config shared --prefix=/opt/openssl-1.1.1/ \
    && make -j$(nproc) \
    && make install \
    && cd .. \
    && rm -rf openssl-1.1.1w openssl-1.1.1w.tar.gz

# Install linuxdeploy and plugins for AppImage creation
RUN wget -q https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage \
    && chmod +x linuxdeploy-x86_64.AppImage \
    && mv linuxdeploy-x86_64.AppImage /usr/local/bin/linuxdeploy

RUN wget -q https://github.com/linuxdeploy/linuxdeploy-plugin-qt/releases/download/continuous/linuxdeploy-plugin-qt-x86_64.AppImage \
    && chmod +x linuxdeploy-plugin-qt-x86_64.AppImage \
    && mv linuxdeploy-plugin-qt-x86_64.AppImage /usr/local/bin/linuxdeploy-plugin-qt

RUN wget -q https://github.com/linuxdeploy/linuxdeploy-plugin-appimage/releases/download/continuous/linuxdeploy-plugin-appimage-x86_64.AppImage \
    && chmod +x linuxdeploy-plugin-appimage-x86_64.AppImage \
    && mv linuxdeploy-plugin-appimage-x86_64.AppImage /usr/local/bin/linuxdeploy-plugin-appimage

# Ensure qmake is in PATH and Qt is properly configured
# CentOS 7 typically has qmake in /usr/bin or /usr/lib64/qt5/bin
ENV PATH="/usr/lib64/qt5/bin:/usr/bin:$PATH"
ENV QT_PLUGIN_PATH="/usr/lib64/qt5/plugins"

# Set working directory
WORKDIR /build

# Copy source code (will be mounted as volume)
VOLUME ["/build"]

# Default command
CMD ["/bin/bash"]
